{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "framework/lib/**/*.js",
    "framework/bin/*.mjs",
    "scripts/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

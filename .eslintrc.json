{
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/load-test.js"
      ],
      "env": {
        "node": false
      },
      "globals": {
        "__ENV": "readonly",
        "console": "readonly"
      }
    },
    {
      "files": [
        "**/get-token.js"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "framework/tcm/**/*.js"
      ],
      "env": {
        "browser": true,
        "node": false
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "allure-report",
    "allure-results",
    "playwright-report",
    "test-results",
    ".claude"
  ]
}
